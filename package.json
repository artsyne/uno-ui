{
  "name": "hebe",
  "version": "0.1.0",
  "scripts": {
    "build:css": "node scripts/build/build-css.js",
    "build:css:dev": "node scripts/build/build-css.js --dev",
    "build:css:prod": "node scripts/build/build-css.js",
    "build:frontend": "node scripts/build/build-new-frontend.js",
    "build:frontend:dev": "node scripts/build/build-new-frontend.js --dev",
    "build:dev": "npm run build:css:dev && npm run build:frontend:dev",
    "build:prod": "npm run build:css:prod && npm run build:frontend",
    "build": "npm run build:dev",
    "create:dirs": "node scripts/build/create-dirs.js",
    "verify:theme": "node scripts/build/verify-theme.js",
    "dev": "npm run build:dev",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint website/static/src/js",
    "test:build": "npm run build:prod && npm run verify:theme",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest tests/unit tests/js/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration tests/js/integration",
    "test:coverage": "jest --coverage",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.7",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/jest-dom": "^6.1.4",
    "autoprefixer": "^10.4.21",
    "css-loader": "^7.1.2",
    "cssnano": "^6.0.5",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-image-snapshot": "^6.2.0",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.5",
    "terser": "^5.39.1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "alpinejs": "^3.15.2",
    "htmx.org": "^2.0.8",
    "mysql2": "^3.14.1"
  }
}
