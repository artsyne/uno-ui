{
  "name": "hebe",
  "version": "0.1.0",
  "scripts": {
    "build:css": "node scripts/build/build-css.js",
    "build:css:dev": "node scripts/build/build-css.js --dev",
    "build:css:prod": "node scripts/build/build-css.js",
    "build:js": "node scripts/build/build-js.js --dev",
    "build:js:dev": "node scripts/build/build-js.js --dev",
    "build:js:prod": "node scripts/build/build-js.js --prod",
    "build:frontend": "node scripts/build/build-new-frontend.js",
    "build:frontend:dev": "node scripts/build/build-new-frontend.js --dev",
    "build:kiko": "cd kiko && node build.js --dev",
    "build:kiko:prod": "cd kiko && node build.js",
    "build:dev": "npm run build:kiko && npm run build:css:dev && npm run build:js:dev && npm run build:frontend:dev",
    "build:prod": "npm run build:kiko:prod && npm run build:css:prod && npm run build:js:prod && npm run build:frontend",
    "build": "npm run build:dev",
    "create:dirs": "node scripts/build/create-dirs.js",
    "verify:theme": "node scripts/build/verify-theme.js",
    "watch:kiko": "cd kiko && node build.js --dev --watch",
    "dev": "npm run build:dev && npm run watch:kiko",
    "test:build": "npm run build:prod && npm run verify:theme",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual",
    "test:performance": "playwright test tests/performance",
    "test:coverage": "jest --coverage",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:report": "jest --coverage && playwright test --reporter=html"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/cli": "^4.1.7",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/jest-dom": "^6.1.4",
    "autoprefixer": "^10.4.21",
    "css-loader": "^7.1.2",
    "cssnano": "^6.0.5",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-image-snapshot": "^6.2.0",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.0",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.5",
    "terser": "^5.39.1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "alpinejs": "^3.15.2",
    "htmx.org": "^2.0.8",
    "mysql2": "^3.14.1"
  }
}
