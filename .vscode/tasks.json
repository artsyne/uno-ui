{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:css",
      "type": "shell",
      "command": "npm run build:css:dev",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build:js",
      "type": "shell",
      "command": "npm run build:frontend:dev",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build:go",
      "type": "shell",
      "command": "go build -o ${workspaceFolder}/__debug_bin/debug.idiary.site ./cmd/idiary/main.go",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "group": "build",
      "problemMatcher": [
        "$go"
      ]
    },
    {
      "label": "build:frontend",
      "dependsOn": [
        "build:css",
        "build:js"
      ],
      "group": "build"
    },
    {
      "label": "build",
      "dependsOn": [
        "build:frontend",
        "build:go"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}