{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:css",
      "type": "shell",
      "command": "npm run build:css",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "build:js",
      "type": "shell",
      "command": "npm run build:js --dev",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "build:go",
      "type": "shell",
      "command": "go build -o ${workspaceFolder}/__debug_bin/debug.idiary.site ./cmd/idiary/main.go",
      "options": {
        "cwd": "${workspaceFolder}/"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$go"]
    },
    {
      "label": "build:css-js",
      "dependsOn": ["build:css", "build:js"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build",
      "dependsOn": ["build:css", "build:js", "build:go"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
