{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server (Go Only)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/__debug_bin/debug.idiary.site",
      "cwd": "${workspaceFolder}/",
      "showLog": true,
      "preLaunchTask": "build:go",
      "dlvFlags": [
        "--log",
        "--log-output=rpc"
      ],
      "envFile": "${workspaceFolder}/.env.local"
    },
    {
      "name": "Debug Server (Full Build)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "program": "${workspaceFolder}/__debug_bin/debug.idiary.site",
      "cwd": "${workspaceFolder}/",
      "showLog": true,
      "preLaunchTask": "build",
      "dlvFlags": [
        "--log",
        "--log-output=rpc"
      ],
      "envFile": "${workspaceFolder}/.env.local",
      "presentation": {
        "group": "launch",
        "order": 1
      }
    }
  ]
}