{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "globals": {
    "Alpine": "readonly",
    "htmx": "readonly",
    "process": "readonly"
  },
  "rules": {
    "prettier/prettier": ["error"]
  }
}
