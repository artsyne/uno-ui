# Hebe应用环境变量配置
# 基本环境配置
IDIARY_ENV=development
IDIARY_GIN_MODE=debug

# 应用配置
IDIARY_DOMAIN=http://127.0.0.1:9090
IDIARY_PORT=9090
IDIARY_SUMMARY_MAX=555
IDIARY_SUFFIX=...
IDIARY_PAGE_SIZE=20
IDIARY_MAX_DIARY_LIMIT=500
IDIARY_STATIC_DIR=./website/static
IDIARY_LOCALES_DIR=./website/locales
IDIARY_DEFAULT_LANG=en
IDIARY_MAX_ENTRY_LENGTH=20000
IDIARY_MAX_COMMENT_LENGTH=1000
IDIARY_MAX_DESCRIPTION_LENGTH=500

# RateLimit配置
IDIARY_RATE_LIMIT_GENERAL=1000.0
IDIARY_RATE_LIMIT_GENERAL_BURST=100
IDIARY_RATE_LIMIT_AUTH=5.0
IDIARY_RATE_LIMIT_AUTH_BURST=10

# 暴力破解防护配置
IDIARY_BRUTE_FORCE_MAX_FAILURES=5
IDIARY_BRUTE_FORCE_LOCKOUT_MINUTES=15

# 用户配置
IDIARY_PWD_MIN_LEN=6
IDIARY_PWD_MAX_LEN=50
IDIARY_USER_STATUS_DEL=0
IDIARY_USER_STATUS_OK=1
IDIARY_USER_STATUS_WAIT_ACTIVE=2
IDIARY_USER_DEFAULT_GROUP=1
IDIARY_HANDLE_COOLDOWN_DAYS=30


# 验证码相关配置
IDIARY_VALID_CODE_LEN=16
IDIARY_VALID_CODE_ACTIVE_USER=1
IDIARY_VALID_CODE_RESET_PWD=2
IDIARY_VALID_CODE_EXPIRE_MINUTES=30

# 数据库配置
IDIARY_DB_HOST=127.0.0.1
IDIARY_DB_PORT=3306
IDIARY_DB_NAME=cd
IDIARY_DB_USER=root
IDIARY_DB_PASSWORD=123123
IDIARY_DB_CONN=%s:%s@tcp(%s:3306)/%s?parseTime=true&loc=Local&charset=utf8mb4&collation=utf8mb4_general_ci

# Cookie配置
IDIARY_COOKIE_DOMAIN=127.0.0.1
IDIARY_COOKIE_SECRET=2GzVloukJl9C7y44O740o59e3sD8xTzr
IDIARY_COOKIE_EXPIRE_DAYS=7
IDIARY_COOKIE_HTTP_ONLY=true

# 邮件配置
IDIARY_SMTP_SERVER=smtpdm.aliyun.com:25
IDIARY_SMTP_USER=noreply@sinodiary.com
IDIARY_SMTP_PASSWORD=HL90rmWKeJjS92
IDIARY_SMTP_PORT=25
IDIARY_SMTP_FROM=noreply@sinodiary.com
IDIARY_EMAIL_MAX_RETRIES=3
IDIARY_EMAIL_BATCH_SIZE=10

# Redis配置
IDIARY_REDIS_HOST=127.0.0.1
IDIARY_REDIS_PORT=6379
IDIARY_REDIS_PASSWORD=woaibeijingtiananmeng

# 上传配置
IDIARY_UPLOAD_PATH=upload/
IDIARY_UPLOAD_TYPES="data:image/jpeg|data:image/jpg|data:image/gif|data:image/png"
IDIARY_UPLOAD_MAX_SIZE=1048576

# 日志配置
IDIARY_LOG_LEVEL=debug
IDIARY_LOG_FORMAT=text
IDIARY_LOG_PATH=./logs
IDIARY_LOG_FILENAME=idiary.log
IDIARY_LOG_MAX_SIZE=100
IDIARY_LOG_MAX_AGE=30
IDIARY_LOG_MAX_BACKUPS=5
IDIARY_LOG_COMPRESS=true
IDIARY_LOG_LOCAL_TIME=true

# 支持的语言(JSON格式)
IDIARY_SUPPORT_LANGS=[{"code":"en","label":"English","local-text":"English"},{"code":"ja","label":"Japanese","local-text":"日本語"},{"code":"ko","label":"Korean","local-text":"한국어"},{"code":"zh-cn","label":"Chinese Simplified","local-text":"简体中文"},{"code":"zh-tw","label":"Chinese Traditional","local-text":"繁體中文"}]

