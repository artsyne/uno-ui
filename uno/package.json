{
  "name": "uno-ui",
  "version": "0.7.0",
  "type": "module",
  "main": "./dist/uno.umd.js",
  "module": "./dist/uno.es.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/uno.es.js",
      "require": "./dist/uno.umd.js"
    }
  },
  "files": [
    "dist",
    "types",
    "src"
  ],
  "sideEffects": [
    "./src/index.js",
    "./dist/*"
  ],
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "alpine",
    "alpinejs",
    "tailwind",
    "ui",
    "components",
    "modal",
    "dialog",
    "notification",
    "tooltip",
    "validation",
    "htmx",
    "ssr",
    "lightweight",
    "typescript"
  ],
  "author": "Uno UI Team",
  "license": "MIT",
  "description": "Lightweight, modern UI component library built on Alpine.js and Tailwind CSS. Store-First, Directive-Driven architecture with TypeScript support, HTMX integration, and zero dependencies.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idiary-ai/uno-ui.git"
  },
  "homepage": "https://github.com/idiary-ai/uno-ui#readme",
  "bugs": {
    "url": "https://github.com/idiary-ai/uno-ui/issues"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "prettier": "^3.7.4",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "alpinejs": "^3.15.2",
    "htmx.org": "^2.0.8"
  }
}
